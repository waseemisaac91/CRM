*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Virtual environments ----------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ---------- PyQt6 / Qt Designer ----------
*.qm
*.qrc
*.spec

# ---------- SECRETS — NEVER COMMIT ----------
credentials/
credentials/*.json
service_account.json
client_secret*.json


# ---------- Environment variables ----------
.env
.env.*


# ---------- Data / caches ----------
data/users_cache.json
data/*.cache.json
data/cache/

# ---------- IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
logs/

# ---------- Secrets (إضافي) ----------
token.json
token.pickle
oauth_credentials.json

# ---------- Keep .env.example ----------
!.env.example